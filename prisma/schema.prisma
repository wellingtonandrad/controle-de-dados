// =============================================================================
// Configuração Prisma — PostgreSQL (Neon) + client gerado em lib/generated/prisma
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// CORE · Módulo 1 — Segurança (auth, usuários, perfis, multi-empresa, RBAC)
// =============================================================================

/// Papel global do usuário na plataforma (fora da empresa).
enum UserRole {
  EXTERNAL        // Visitante / sem painel de titular
  ACCOUNT_HOLDER  // Pode possuir empresa e acessar o painel ERP
}

/// Papel do usuário dentro de uma organização (empresa).
enum OrganizationMemberRole {
  OWNER   // Dono — configura módulos, equipe, cargos
  MANAGER // Gestor — relatórios e operações amplas
  STAFF   // Operacional — escopo definido pelos grupos de permissão
}

// -----------------------------------------------------------------------------
// CORE · Módulo 2 — Cadastros + comercial (status de documentos)
// -----------------------------------------------------------------------------

/// Venda: orçamento (rascunho) vs venda confirmada vs cancelada.
enum SaleStatus {
  DRAFT     // Orçamento — não conta como venda fechada no painel
  CONFIRMED // Venda efetiva
  CANCELLED // Cancelada
}

/// Compra: mesma lógica de rascunho / confirmada / cancelada.
enum PurchaseStatus {
  DRAFT     // Pedido em elaboração
  CONFIRMED // Compra registrada (pode gerar entrada de estoque)
  CANCELLED // Cancelada
}

/// Agenda pública / serviços (módulo SERVICES).
enum AppointmentStatus {
  SCHEDULED // Agendado
  COMPLETED // Realizado
  NO_SHOW   // Cliente não compareceu
  CANCELED  // Cancelado
}

// -----------------------------------------------------------------------------
// CORE · Módulo 4 — Operação (estoque e produção)
// -----------------------------------------------------------------------------

/// Tipo de movimentação de estoque (entrada, saída, ajuste, consumo em atendimento).
enum StockMovementKind {
  IN                      // Entrada
  OUT                     // Saída
  ADJUSTMENT              // Ajuste de inventário
  APPOINTMENT_CONSUMPTION // Baixa automática por agendamento/serviço
}

/// Classificação do item no catálogo (MP=materia-prima, PA=produto acabado, etc.).
enum ProductItemType {
  MP // Matéria-prima
  PI // Produto intermediário
  PA // Produto acabado
  EM // Embalagem
  SV // Serviço
}

/// Ordem de produção (módulo INDUSTRY).
enum ProductionOrderStatus {
  PLANNED     // Planejada
  RELEASED    // Liberada para o chão
  IN_PROGRESS // Em produção
  PAUSED      // Pausada
  FINISHED    // Finalizada
  CANCELLED   // Cancelada
}

// -----------------------------------------------------------------------------
// Plug-in LOGISTICS — mapas, entregas e GPS
// -----------------------------------------------------------------------------

/// Camada geográfica importada de KMZ/KML.
enum GeoMapLayerCategory {
  DELIVERY_REGION      // Região de entrega
  FACTORY_SITE         // Unidade / fábrica
  NEIGHBORHOOD_BOUNDARY // Limite de bairro ou zona
  PLANNED_ROUTE        // Rota planejada
}

/// Origem do ponto GPS na viagem.
enum GpsSubjectType {
  DELIVERER        // Entregador (pessoa)
  COMPANY_VEHICLE  // Veículo da empresa
}

/// Situação da entrega no instante em que o ponto foi registrado.
enum DeliveryProgressStatus {
  SCHEDULED
  LOADING
  OUT_FOR_DELIVERY
  IN_TRANSIT
  AT_CUSTOMER
  DELIVERED
  EXCEPTION   // Problema na entrega
  RETURNING
  CANCELLED
}

/// Ciclo de vida da viagem / entrega.
enum DeliveryTripStatus {
  DRAFT     // Rascunho — viagem criada, ainda não em rota
  ACTIVE    // Em andamento (coleta de GPS)
  COMPLETED // Concluída
  CANCELLED // Cancelada
}

// -----------------------------------------------------------------------------
// Módulos verticais plugáveis (CORE permanece sempre ativo — não está neste enum)
// -----------------------------------------------------------------------------

/// Setores opcionais por empresa: menu e rotas em /dashboard/* filtrados por enabledModules.
enum ErpVerticalModule {
  LOGISTICS // Frota, KMZ, entregas, GPS (e protótipo lotes/coletor)
  MARKETS   // PDV / varejo (piloto)
  SERVICES  // Agenda, serviços, página pública /empresa/[id]
  HOSPITALS // Saúde (evolução)
  INDUSTRY  // Engenharia, BOM, produção, necessidades
}

// -----------------------------------------------------------------------------
// CORE · Módulo 6 — Auditoria (categorias de evento)
// -----------------------------------------------------------------------------

enum AuditLogCategory {
  STOCK        // Estoque
  SALE         // Vendas
  FINANCE      // Financeiro (contas a receber, etc.)
  LOGISTICS    // Logística
  ORGANIZATION // Empresa, módulos, equipe
}

// =============================================================================
// Multi-empresa — tenant principal do ERP
// =============================================================================

/// Empresa (tenant). Agrupa todos os dados operacionais e módulos ativos.
model Organization {
  id          String @id @default(cuid())
  ownerUserId String // Titular da conta (User ACCOUNT_HOLDER)
  owner       User   @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  name     String
  slug     String  @unique // URL pública: /empresa/[slug]
  document String? // CNPJ/CPF
  email    String?
  phone    String?

  verified Boolean @default(false) // Aprovação / onboarding
  active   Boolean @default(true)

  /// Plug-ins verticais ligados (Logística, Serviços, Indústria…). CORE não aparece aqui.
  enabledModules ErpVerticalModule[] @default([LOGISTICS, SERVICES, INDUSTRY])

  // Relações — resumo por área do CORE + plug-ins
  members          OrganizationMember[]
  accountGroups    AccountGroup[] // Cargos / perfis de permissão
  roleAssignments  OrganizationMemberGroup[]
  customers        Customer[] // Cadastros
  products         Product[]
  sales            Sale[] // Comercial
  salesGoals       SalesGoal[]
  suppliers        Supplier[]
  purchases        Purchase[]
  appointments     Appointment[] // SERVICES
  services         Service[]
  stockItems       StockItem[] // Operação / estoque
  reminders        Reminder[]
  receivables      Receivable[] // Financeiro
  workCenters      WorkCenter[] // INDUSTRY
  billsOfMaterials BillOfMaterial[]
  productionOrders ProductionOrder[]
  geoMapLayers     GeoMapLayer[] // LOGISTICS
  deliveryTrips    DeliveryTrip[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

/// Vínculo usuário ↔ empresa (equipe).
model OrganizationMember {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole // OWNER | MANAGER | STAFF

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountGroups OrganizationMemberGroup[] // Grupos de permissão (cargos)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Permissão atômica do sistema (ex.: reports:view, stock:write).
model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // Chave usada no código (RBAC)
  label     String   // Nome exibido na UI de cargos
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups AccountGroupPermission[]
}

/// Grupo de permissões = “cargo” customizável por empresa.
model AccountGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false) // Grupos criados pelo seed (não apagar)

  permissions AccountGroupPermission[]
  members     OrganizationMemberGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// N:N cargo ↔ permissão.
model AccountGroupPermission {
  id           String       @id @default(cuid())
  groupId      String
  permissionId String
  group        AccountGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([groupId, permissionId])
  @@index([permissionId])
}

/// N:N membro da equipe ↔ cargo.
model OrganizationMemberGroup {
  id                   String             @id @default(cuid())
  organizationMemberId String
  accountGroupId       String
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  accountGroup         AccountGroup       @relation(fields: [accountGroupId], references: [id], onDelete: Cascade)
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())

  @@unique([organizationMemberId, accountGroupId])
  @@index([organizationId, organizationMemberId])
}

// =============================================================================
// CORE · Módulo 2 — Cadastros
// =============================================================================

/// Cliente da empresa (B2B ou consumidor).
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  email      String?
  phone      String?
  document   String?
  address    String?
  city       String?
  state      String?
  postalCode String?
  notes      String?
  active     Boolean @default(true)

  sales       Sale[]
  receivables Receivable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, name])
}

/// Produto vendável / comprável / usado em BOM e produção.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  sku        String // Único por empresa
  unit       String          @default("un")
  itemType   ProductItemType @default(PA)
  priceCents Int // Preço de venda (centavos)
  costCents  Int? // Custo (opcional)
  active     Boolean         @default(true)

  saleLines         SaleLine[]
  purchaseLines     PurchaseLine[]
  bomParents        BillOfMaterial[]         @relation("BomProduct")
  bomComponents     BomItem[]                @relation("BomComponentProduct")
  productionOrders  ProductionOrder[]
  materialPlanLines ProductionMaterialPlan[] @relation("MaterialPlanComponent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, active])
}

/// Fornecedor (compras).
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  email    String?
  phone    String?
  document String?
  notes    String?
  active   Boolean @default(true)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, name])
}

// =============================================================================
// CORE · Comercial (vendas e compras)
// =============================================================================

/// Pedido de venda ou orçamento (status DRAFT = orçamento).
model Sale {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  status     SaleStatus @default(CONFIRMED)
  totalCents Int
  notes      String?

  lines         SaleLine[]
  deliveryTrips DeliveryTrip[] // LOGISTICS — entrega opcional da venda

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([customerId])
}

/// Item da venda.
model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  @@index([saleId])
}

/// Meta mensal de faturamento / pedidos (dashboard de vendas).
model SalesGoal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year         Int
  month        Int
  revenueCents Int @default(0)
  ordersCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, year, month])
  @@index([organizationId, year, month])
}

/// Pedido de compra ao fornecedor.
model Purchase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  status     PurchaseStatus @default(CONFIRMED)
  totalCents Int
  notes      String?

  lines PurchaseLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([supplierId])
}

/// Item da compra.
model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity       Int
  unitCostCents  Int
  lineTotalCents Int

  @@index([purchaseId])
}

// =============================================================================
// Plug-in SERVICES — agenda e serviços
// =============================================================================

/// Agendamento feito pela página pública da empresa.
model Appointment {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  appointmentDate DateTime
  time            String

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status AppointmentStatus @default(SCHEDULED)

  installments AppointmentInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Catálogo de serviços (barbearia, consulta, etc.).
model Service {
  id       String  @id @default(cuid())
  name     String
  price    Int // Centavos
  duration Int // Minutos
  status   Boolean @default(true) // Ativo na agenda

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  appointment              Appointment[]
  serviceStockConsumptions ServiceStockConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// CORE · Módulo 4 — Estoque (materiais; distinto de Product no catálogo comercial)
// =============================================================================

/// Item de estoque (pode ser nome diferente do Product — consumo em serviços).
model StockItem {
  id              String  @id @default(cuid())
  name            String
  unit            String  @default("un")
  currentQuantity Int     @default(0)
  minimumQuantity Int     @default(0) // Alerta de estoque baixo
  active          Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  movements           StockMovement[]
  serviceConsumptions ServiceStockConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// Histórico de movimentação (append-only na prática).
model StockMovement {
  id          String    @id @default(cuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  kind            StockMovementKind
  quantity        Int
  note            String?
  appointmentId   String? // Se kind = APPOINTMENT_CONSUMPTION
  createdByUserId String?

  createdAt DateTime @default(now())

  @@index([stockItemId, createdAt])
}

/// Receita de consumo: quanto de cada material um serviço gasta.
model ServiceStockConsumption {
  id          String    @id @default(cuid())
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, stockItemId])
}

// =============================================================================
// CORE · Módulo 3 — Financeiro (contas a receber; PIX/NFS-e futuros)
// =============================================================================

/// Parcelas de pagamento ligadas a um agendamento.
model AppointmentInstallment {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  sequence    Int
  amountCents Int
  dueDate     DateTime
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appointmentId, sequence])
}

/// Conta a receber manual (cobrança avulsa).
model Receivable {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  description     String
  amountCents     Int
  dueDate         DateTime
  paidAt          DateTime? // null = em aberto
  notes           String?
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, dueDate])
  @@index([organizationId, paidAt])
}

/// Lembrete interno da empresa (painel).
model Reminder {
  id             String       @id @default(cuid())
  description    String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Plug-in INDUSTRY — engenharia, BOM, produção, necessidades
// =============================================================================

/// Centro de trabalho / máquina na rota de produção.
model WorkCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name              String
  code              String?
  capacityPerDayMin Int     @default(480) // Capacidade diária em minutos
  active            Boolean @default(true)

  routingSteps      RoutingStep[]
  productionReports ProductionReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// Lista de materiais (BOM) de um produto acabado.
model BillOfMaterial {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation("BomProduct", fields: [productId], references: [id], onDelete: Cascade)

  version String
  active  Boolean @default(true)
  notes   String?

  items            BomItem[]
  routingSteps     RoutingStep[]
  productionOrders ProductionOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, productId, version])
  @@index([organizationId, active])
}

/// Componente da BOM (quantidade + perda).
model BomItem {
  id String @id @default(cuid())

  bomId String
  bom   BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)

  componentProductId String
  componentProduct   Product @relation("BomComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)

  quantity    Float
  lossPercent Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bomId, componentProductId])
  @@index([bomId])
}

/// Etapa da rota (sequência no centro de trabalho).
model RoutingStep {
  id String @id @default(cuid())

  bomId String
  bom   BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)

  workCenterId String
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Restrict)

  sequence Int
  name     String
  setupMin Int @default(0)
  cycleMin Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bomId, sequence])
  @@index([bomId])
}

/// Ordem de produção no chão de fábrica.
model ProductionOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bomId String
  bom   BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Restrict)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  status           ProductionOrderStatus @default(PLANNED)
  plannedQuantity  Int
  producedQuantity Int                   @default(0)
  scrapQuantity    Int                   @default(0)

  plannedStart DateTime?
  plannedEnd   DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  notes        String?

  reports       ProductionReport[]
  materialPlans ProductionMaterialPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, createdAt])
}

/// Plano de materiais da OP (consumo previsto vs realizado).
model ProductionMaterialPlan {
  id String @id @default(cuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  componentProductId String
  componentProduct   Product @relation("MaterialPlanComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  plannedQty  Float
  consumedQty Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productionOrderId, componentProductId])
  @@index([productionOrderId])
}

/// Apontamento de produção (boa quantidade, refugo, tempo).
model ProductionReport {
  id String @id @default(cuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  workCenterId String?
  workCenter   WorkCenter? @relation(fields: [workCenterId], references: [id], onDelete: SetNull)

  goodQuantity    Int     @default(0)
  scrapQuantity   Int     @default(0)
  runtimeMin      Int     @default(0)
  notes           String?
  createdByUserId String?

  createdAt DateTime @default(now())

  @@index([productionOrderId, createdAt])
}

// =============================================================================
// Plug-in LOGISTICS — mapas KMZ, viagens e rastreamento GPS
// =============================================================================

/// Camada de mapa (GeoJSON persistido após import KMZ/KML).
model GeoMapLayer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  category       GeoMapLayerCategory
  geoJson        Json // FeatureCollection
  sourceFileName String? // Nome do arquivo original

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, category])
}

/// Viagem de entrega (pode vincular a uma venda).
model DeliveryTrip {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  referenceCode String? // Código interno da rota
  description   String?
  driverLabel   String? // Nome do entregador
  vehicleLabel  String? // Placa / veículo

  status DeliveryTripStatus @default(DRAFT)

  gpsPoints GpsTrackPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([saleId])
}

/// Ponto de GPS ao longo da viagem.
model GpsTrackPoint {
  id String @id @default(cuid())

  tripId String
  trip   DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  latitude   Float
  longitude  Float
  recordedAt DateTime

  subject        GpsSubjectType
  deliveryStatus DeliveryProgressStatus

  note String?

  createdAt DateTime @default(now())

  @@index([tripId, recordedAt])
}

// =============================================================================
// CORE · Módulo 6 — Auditoria (trilha de ações; append-only na prática)
// =============================================================================

/// Registro de auditoria por organização (quem fez o quê).
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  category   AuditLogCategory
  action     String // Ex.: sale.create, stock.movement
  summary    String // Texto legível
  entityType String? // Ex.: Sale, StockItem
  entityId   String?
  metadata   Json? // Detalhes extras

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, category, createdAt])
}

// =============================================================================
// NextAuth / Auth.js — usuário e sessão OAuth (Google/GitHub)
// =============================================================================

/// Usuário da plataforma (login social).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  role    UserRole @default(EXTERNAL)
  address String?  @default("")
  phone   String?  @default("")
  status  Boolean  @default(true)

  timeZone           String?
  stripe_customer_id String? // Legado Stripe (portal)
  times              String[] @default([]) // Horários agenda (legado)

  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[] // WebAuthn (se habilitado)

  organizationsOwned      Organization[]       @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  auditLogs               AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Conta OAuth vinculada (Google, GitHub).
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

/// Sessão ativa do usuário.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Token de verificação de e-mail (Auth.js).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Credencial WebAuthn / passkey.
model Authenticator {
  credentialID         String
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@unique([credentialID])
}
