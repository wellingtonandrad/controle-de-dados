# Copie para .env local ou configure no Vercel: Project → Settings → Environment Variables.
# Nunca commite o arquivo .env (já está no .gitignore).

# -----------------------------------------------------------------------------
# Vercel / produção — URLs públicas (sem barra no final)
# -----------------------------------------------------------------------------
# Domínio que o Vercel te deu (ex.: https://controle-de-dados.vercel.app)
NEXT_PUBLIC_URL=https://SEU_PROJETO.vercel.app

# NextAuth / Auth.js — URL canônica do app (normalmente igual a NEXT_PUBLIC_URL)
NEXTAUTH_URL=https://SEU_PROJETO.vercel.app

# -----------------------------------------------------------------------------
# Obrigatório — sessão e banco
# -----------------------------------------------------------------------------
AUTH_SECRET=
# Alternativa aceita pelo código:
# NEXTAUTH_SECRET=

DATABASE_URL=

# -----------------------------------------------------------------------------
# Login GitHub (o projeto registra só GitHub em lib/auth/build-providers.ts)
# -----------------------------------------------------------------------------
# GitHub OAuth App → Authorization callback URL:
#   {NEXTAUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Legado aceito pelo código:
# GITHUB_ID=
# GITHUB_SECRET=

# -----------------------------------------------------------------------------
# Stripe (checkout, assinaturas, webhook)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_SECRET_WEBHOOK_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# price_... ou prod_... (produto com preço padrão ativo)
STRIPE_PLAN_BASIC=
STRIPE_PLAN_PROFESSIONAL=
# URLs após checkout (use seu domínio Vercel)
STRIPE_SUCCESS_URL=https://SEU_PROJETO.vercel.app/dashboard
# Typo histórico no código — ainda é lido como fallback:
# STRIPE_SUCESSS_URL=
STRIPE_CANCEL_URL=https://SEU_PROJETO.vercel.app/dashboard
# Portal do cliente Stripe (return_url)
STRIPE_SUCESSS_URL=https://SEU_PROJETO.vercel.app/dashboard

# -----------------------------------------------------------------------------
# Cloudinary — upload de avatar (app/api/image/upload/route.ts)
# -----------------------------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# -----------------------------------------------------------------------------
# E-mail (orçamentos, lembretes de contas a receber)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Cron — POST /api/jobs/receivables-reminders com header x-cron-secret
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Página pública da clínica — e-mails permitidos (opcional, CSV)
# -----------------------------------------------------------------------------
# CLINIC_ALLOWED_EMAILS=email1@x.com,email2@x.com

# -----------------------------------------------------------------------------
# ⚠️ Apenas desenvolvimento / demo — NÃO use em produção com dados reais
# -----------------------------------------------------------------------------
# PANEL_NO_AUTH=true
# DEMO_PANEL_USER_EMAIL=demo@exemplo.local

# -----------------------------------------------------------------------------
# Google OAuth — o build atual não registra Google (mantido por compatibilidade)
# -----------------------------------------------------------------------------
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
